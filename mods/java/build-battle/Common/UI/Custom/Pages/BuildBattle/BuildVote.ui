@TitleStyle = LabelStyle(
  FontSize: 24,
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center,
  TextColor: #f5d77a
);

@BodyStyle = LabelStyle(
  FontSize: 16,
  HorizontalAlignment: Center,
  VerticalAlignment: Center,
  TextColor: #d6e0ea
);

@ScoreLabel = LabelStyle(
  FontSize: 20,
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center,
  TextColor: #ffffff
);

@ScoreStyle = TextButtonStyle(
  Default: (Background: (Color: #315f8f), LabelStyle: @ScoreLabel),
  Hovered: (Background: (Color: #4b83ba), LabelStyle: @ScoreLabel),
  Pressed: (Background: (Color: #24496e), LabelStyle: @ScoreLabel)
);

Group #BuildBattleVoteOverlay {
  Background: (Color: #000000(0.74));
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 560, Height: 260);
    Background: (Color: #172331);
    LayoutMode: Top;
    Padding: (Full: 24);

    Label {
      Anchor: (Height: 38);
      Text: %server.customUI.buildBattle.voteBuild.title;
      Style: @TitleStyle;
    }

    Label #TargetName {
      Anchor: (Height: 38, Bottom: 12);
      Text: "Team";
      Style: @BodyStyle;
    }

    Label {
      Anchor: (Height: 34, Bottom: 12);
      Text: %server.customUI.buildBattle.voteBuild.prompt;
      Style: @BodyStyle;
    }

    Group {
      Anchor: (Height: 58);
      LayoutMode: Left;

      TextButton #Score1 { FlexWeight: 1; Anchor: (Right: 4); Text: "1"; Style: @ScoreStyle; }
      TextButton #Score2 { FlexWeight: 1; Anchor: (Horizontal: 4); Text: "2"; Style: @ScoreStyle; }
      TextButton #Score3 { FlexWeight: 1; Anchor: (Horizontal: 4); Text: "3"; Style: @ScoreStyle; }
      TextButton #Score4 { FlexWeight: 1; Anchor: (Horizontal: 4); Text: "4"; Style: @ScoreStyle; }
      TextButton #Score5 { FlexWeight: 1; Anchor: (Left: 4); Text: "5"; Style: @ScoreStyle; }
    }
  }
}
