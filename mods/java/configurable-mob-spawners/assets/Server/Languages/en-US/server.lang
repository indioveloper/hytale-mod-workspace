items.OrbGenesis_Configurable_Mob_Spawner.name = Configurable Mob Spawner
items.OrbGenesis_Configurable_Mob_Spawner.description = A solid adventure-mineable block that spawns configured NPC waves. Interact in Creative mode to edit it.

customUI.configurableSpawners.title = Configurable Mob Spawner
customUI.configurableSpawners.creativeOnly = This spawner can only be configured in Creative mode.
customUI.configurableSpawners.saved = Mob spawner configuration saved.
customUI.configurableSpawners.enabled = Enabled
customUI.configurableSpawners.roleSearch.placeholder = Search spawnable mob...
customUI.configurableSpawners.preview.tooltip = Selecting a mob displays its real 3D model in front of you. The preview is temporary and never saved into the world.
customUI.configurableSpawners.mobName = Display name
customUI.configurableSpawners.mobName.placeholder = Empty = vanilla name
customUI.configurableSpawners.tag.placeholder = Comma-separated tags
customUI.configurableSpawners.tag.tooltip = Each tag accepts 1-64 letters, numbers, _, ., : or -. They are stored to identify the block through Trigger Volume signals.
customUI.configurableSpawners.cadenceMin = Min cadence (s)
customUI.configurableSpawners.cadenceMax = Max cadence (s)
customUI.configurableSpawners.countMin = Min per wave
customUI.configurableSpawners.countMax = Max per wave
customUI.configurableSpawners.maxAlive = Max alive
