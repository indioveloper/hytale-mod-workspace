customUI.triggerVolumeEffectEditor.effectType.SpawnParticleShape = Spawn particle shape
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape = Shape
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape.tooltip = Geometry drawn by the particle points. Cube draws its 12 edges; sphere draws its outer surface; line joins Start and End.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape.option.CubeEdges = Cube (edges)
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape.option.SphereSurface = Sphere (surface)
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape.option.Line = Line
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleSystem = Particle system
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleSystem.tooltip = ParticleSystem spawned at every calculated point. Use a point-like system for clean geometry. Default: OrbGenesis_Shape_Point_Red.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.CoordinateMode = Coordinate mode
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.CoordinateMode.tooltip = Relative adds the configured coordinates to the center of this Trigger Volume; absolute uses world coordinates directly.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.CoordinateMode.option.RelativeToVolume = Relative to Trigger Volume center
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.CoordinateMode.option.Absolute = Absolute world coordinates
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Center = Center
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Center.tooltip = Cube or sphere center in blocks. In relative mode, (0, 0, 0) is the center of this Trigger Volume.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Start = Line start
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Start.tooltip = First XYZ point of a line, in blocks. Used only when Shape is Line.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.End = Line end
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.End.tooltip = Final XYZ point of a line, in blocks. Used only when Shape is Line.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Size = Size
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Size.tooltip = Cube edge length or sphere diameter in blocks. Ignored for lines. Example: 5.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Size.placeholder = e.g. 5
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Spacing = Point spacing
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Spacing.tooltip = Desired distance between points in blocks. Smaller values look denser but cost more. Example: 0.12.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Spacing.placeholder = e.g. 0.12
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleScale = Particle scale
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleScale.tooltip = Scale multiplier applied to the selected ParticleSystem. Example: 1.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleScale.placeholder = e.g. 1
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Duration = Duration
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Duration.tooltip = Number of seconds the point emitters remain active. Example: 10.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Duration.placeholder = e.g. 10
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.MaxPoints = Point limit
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.MaxPoints.tooltip = Safety limit for generated emitters. If reached, spacing is increased evenly. Valid range: 8 to 4096. Example: 512.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.MaxPoints.placeholder = e.g. 512
