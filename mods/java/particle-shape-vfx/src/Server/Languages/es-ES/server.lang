customUI.triggerVolumeEffectEditor.effectType.SpawnParticleShape = Crear figura de particulas
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape = Figura
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape.tooltip = Geometria dibujada por los puntos. Cubo traza sus 12 aristas; esfera traza su superficie exterior; linea une Inicio y Fin.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape.option.CubeEdges = Cubo (aristas)
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape.option.SphereSurface = Esfera (superficie)
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Shape.option.Line = Linea
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleSystem = Sistema de particulas
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleSystem.tooltip = ParticleSystem que aparece en cada punto calculado. Usa un sistema puntual para obtener figuras limpias. Predeterminado: OrbGenesis_Shape_Point_Red.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.CoordinateMode = Modo de coordenadas
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.CoordinateMode.tooltip = Relativas suma las coordenadas al centro de este Trigger Volume; absolutas usa directamente coordenadas del mundo.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.CoordinateMode.option.RelativeToVolume = Relativas al centro del Trigger Volume
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.CoordinateMode.option.Absolute = Coordenadas absolutas del mundo
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Center = Centro
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Center.tooltip = Centro del cubo o la esfera en bloques. En modo relativo, (0, 0, 0) es el centro de este Trigger Volume.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Start = Inicio de la linea
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Start.tooltip = Primer punto XYZ de la linea, en bloques. Solo se usa cuando Figura es Linea.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.End = Fin de la linea
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.End.tooltip = Punto XYZ final de la linea, en bloques. Solo se usa cuando Figura es Linea.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Size = Tamano
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Size.tooltip = Longitud de la arista del cubo o diametro de la esfera en bloques. Se ignora para lineas. Ejemplo: 5.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Size.placeholder = p. ej. 5
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Spacing = Separacion entre puntos
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Spacing.tooltip = Distancia deseada entre puntos en bloques. Un valor menor se ve mas denso pero cuesta mas. Ejemplo: 0.12.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Spacing.placeholder = p. ej. 0.12
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleScale = Escala de las particulas
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleScale.tooltip = Multiplicador de escala aplicado al ParticleSystem elegido. Ejemplo: 1.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.ParticleScale.placeholder = p. ej. 1
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Duration = Duracion
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Duration.tooltip = Segundos durante los que permanecen activos los emisores puntuales. Ejemplo: 10.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.Duration.placeholder = p. ej. 10
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.MaxPoints = Limite de puntos
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.MaxPoints.tooltip = Limite de seguridad para emisores generados. Si se alcanza, la separacion aumenta de forma uniforme. Rango valido: 8 a 4096. Ejemplo: 512.
customUI.triggerVolumeEffectEditor.field.SpawnParticleShape.MaxPoints.placeholder = p. ej. 512
