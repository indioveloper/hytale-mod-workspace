customUI.triggerVolumeEffectEditor.effectType.AttachMovingParticles = Anclar particulas moviles
customUI.triggerVolumeEffectEditor.effectType.AttachMovingParticles.tooltip = Ancla un sistema de particulas a entidades existentes dentro del volumen. No es Reproducir VFX: Reproducir VFX crea un efecto de mundo que no sigue a la plataforma.

customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetX = Destino X
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetX.tooltip = Destino X segun el tipo de coordenadas elegido.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetX.placeholder = ej. 120
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetY = Destino Y
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetY.tooltip = Destino Y segun el tipo de coordenadas elegido.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetY.placeholder = ej. 64
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetZ = Destino Z
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetZ.tooltip = Destino Z segun el tipo de coordenadas elegido.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetZ.placeholder = ej. -30
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.CoordinateMode = Tipo de coordenadas
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.CoordinateMode.tooltip = Absolutas usa las coordenadas del mundo. Relativas desplaza cada entidad desde su posicion actual.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.CoordinateMode.option.ABSOLUTE = Absolutas
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.CoordinateMode.option.RELATIVE = Relativas
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.Speed = Velocidad X
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.Speed.tooltip = Velocidad de movimiento en X, en bloques por segundo. Usa 0 para dejar X quieto.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.SpeedY = Velocidad Y
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.SpeedY.tooltip = Velocidad de movimiento en Y, en bloques por segundo. Usa 0 para dejar Y quieto.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.SpeedZ = Velocidad Z
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.SpeedZ.tooltip = Velocidad de movimiento en Z, en bloques por segundo. Usa 0 para dejar Z quieto.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.LoopBack = Volver al inicio en bucle
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.LoopBack.tooltip = Activalo para ir al destino y volver indefinidamente por la misma linea recta. Desactivalo para moverse una vez y quedarse en el destino.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.DestroyAtDestination = Destruir al llegar
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.DestroyAtDestination.tooltip = Elimina la entidad cuando alcanza el destino. Si tambien activas el bucle, la entidad se destruye en la primera llegada y no inicia el regreso.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection = Direccion de giro
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection.tooltip = Gira respecto a la orientacion actual de la entidad mientras se desplaza.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection.option.NONE = Sin giro
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection.option.RIGHT = Derecha
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection.option.LEFT = Izquierda
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnAngle = Angulo de giro
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnAngle.tooltip = Angulo entre 0 y 180 grados. El giro termina al llegar al destino.
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.CollisionConfig = Configuracion de colision
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.CollisionConfig.tooltip = Usa HardCollision para que el jugador pueda subir a la entidad y sea transportado por ella. SoftCollision permite atravesarla.
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.CollisionConfig.placeholder = HardCollision
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.OnlyFirstMatch = Solo la primera plataforma
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.OnlyFirstMatch.tooltip = Activalo si la colision debe aplicarse a un solo prop o marcador NPC encontrado.
customUI.triggerVolumeEffectEditor.field.RemovePlayerPlatformCollision.OnlyFirstMatch = Solo la primera plataforma
customUI.triggerVolumeEffectEditor.field.RemovePlayerPlatformCollision.OnlyFirstMatch.tooltip = Activalo si la colision debe quitarse de un solo prop o marcador NPC encontrado.

customUI.triggerVolumeEffectEditor.field.SpawnItems.Item = Item
customUI.triggerVolumeEffectEditor.field.SpawnItems.Item.tooltip = Item que se mostrara como una entidad-prop persistente. No se puede recoger ni se combina con otros items.
customUI.triggerVolumeEffectEditor.field.SpawnItems.X = Coordenada X
customUI.triggerVolumeEffectEditor.field.SpawnItems.X.tooltip = Coordenada mundial X o desplazamiento X desde el Trigger Volume, segun el modo elegido.
customUI.triggerVolumeEffectEditor.field.SpawnItems.X.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.Y = Coordenada Y
customUI.triggerVolumeEffectEditor.field.SpawnItems.Y.tooltip = Coordenada mundial Y o desplazamiento Y desde el Trigger Volume, segun el modo elegido.
customUI.triggerVolumeEffectEditor.field.SpawnItems.Y.placeholder = ej. 2
customUI.triggerVolumeEffectEditor.field.SpawnItems.Z = Coordenada Z
customUI.triggerVolumeEffectEditor.field.SpawnItems.Z.tooltip = Coordenada mundial Z o desplazamiento Z desde el Trigger Volume, segun el modo elegido.
customUI.triggerVolumeEffectEditor.field.SpawnItems.Z.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.CoordinateMode = Tipo de coordenadas
customUI.triggerVolumeEffectEditor.field.SpawnItems.CoordinateMode.tooltip = Absolutas usa coordenadas del mundo. Relativas suma XYZ al origen del Trigger Volume.
customUI.triggerVolumeEffectEditor.field.SpawnItems.CoordinateMode.option.ABSOLUTE = Absolutas
customUI.triggerVolumeEffectEditor.field.SpawnItems.CoordinateMode.option.RELATIVE_TO_VOLUME = Relativas al volumen
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationX = Rotacion X
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationX.tooltip = Inclinacion sobre el eje X, en grados. Ejemplo: 90.
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationX.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationY = Rotacion Y
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationY.tooltip = Giro sobre el eje Y, en grados. Ejemplo: 180.
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationY.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationZ = Rotacion Z
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationZ.tooltip = Inclinacion sobre el eje Z, en grados. Ejemplo: 45.
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationZ.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.Scale = Escala
customUI.triggerVolumeEffectEditor.field.SpawnItems.Scale.tooltip = Multiplicador de tamano. 1 es el tamano normal del spawner vanilla, 0.5 la mitad y 2 el doble.
customUI.triggerVolumeEffectEditor.field.SpawnItems.Scale.placeholder = ej. 1
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision = Tipo de colision
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision.tooltip = Sin colision permite atravesar la entidad. Dura crea una superficie solida para el jugador. Suave permite atravesarla pero mantiene interacciones de colision no bloqueantes.
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision.option.NONE = Sin colision
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision.option.HARD = Dura
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision.option.SOFT = Suave

customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.ParticleSystem = Sistema de particulas
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.ParticleSystem.tooltip = IMPORTANTE: este efecto no crea ni mueve una entidad. Coloca la entidad existente dentro del Trigger Volume, ejecuta este efecto antes de Mover entidad y deja Desacoplar de la entidad desactivado. Selecciona aqui el sistema emitido desde esa entidad.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetX = Offset X
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetX.tooltip = Offset X local desde el anclaje de la entidad, en bloques. Ejemplo: 0.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetX.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetY = Offset Y
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetY.tooltip = Offset Y local desde el anclaje de la entidad, en bloques. Usa un valor negativo para colocar el emisor bajo la plataforma.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetY.placeholder = ej. -1
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetZ = Offset Z
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetZ.tooltip = Offset Z local desde el anclaje de la entidad, en bloques. Ejemplo: 0.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetZ.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationX = Rotacion X
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationX.tooltip = Inclinacion del emisor en grados respecto a la entidad. Ejemplo: 180 para invertir su direccion vertical.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationX.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationY = Rotacion Y
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationY.tooltip = Giro horizontal del emisor en grados respecto a la entidad. Ejemplo: 90.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationY.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationZ = Rotacion Z
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationZ.tooltip = Inclinacion lateral del emisor en grados respecto a la entidad. Ejemplo: 0.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationZ.placeholder = ej. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.Scale = Escala
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.Scale.tooltip = Multiplicador de tamano de las particulas. 1 es normal, 0.5 la mitad y 2 el doble.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.Scale.placeholder = ej. 1
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.TargetNodeName = Nodo del modelo
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.TargetNodeName.tooltip = Nombre opcional de un hueso o nodo de la jerarquia del modelo. El emisor sigue ese punto animado, por ejemplo una mano o la tobera de un motor. Dejalo vacio para usar la raiz de la entidad; un nodo inexistente puede colocar mal el efecto o impedir que aparezca.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.TargetNodeName.placeholder = ej. engine_nozzle
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.DetachEmittedParticles = Desacoplar de la entidad
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.DetachEmittedParticles.tooltip = Comportamiento vanilla de las particulas de modelo. Dejalo desactivado para que el sistema siga a la entidad movil. Activalo para un efecto puntual que deba quedarse donde empezo, como una explosion o un impacto mientras el proyectil sigue avanzando.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.ClearOnEntityRemove = Limpiar al eliminar la entidad
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.ClearOnEntityRemove.tooltip = Elimina las particulas ancladas restantes cuando se destruye o retira la plataforma.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OnlyFirstMatch = Solo la entidad mas cercana
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OnlyFirstMatch.tooltip = Desactivado ancla el sistema a todas las entidades del volumen. Activado lo ancla solo a la entidad mas cercana al centro. Normalmente dejalo desactivado y ajusta el volumen alrededor de la plataforma deseada.
