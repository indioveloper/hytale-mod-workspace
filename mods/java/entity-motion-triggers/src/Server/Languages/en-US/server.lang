customUI.triggerVolumeEffectEditor.effectType.ApplyHorizontalPlatformMotion = Move entity
customUI.triggerVolumeEffectEditor.effectType.StopHorizontalPlatformMotion = Stop horizontal platform
customUI.triggerVolumeEffectEditor.effectType.ApplyPlayerPlatformCollision = Enable player platform collision
customUI.triggerVolumeEffectEditor.effectType.RemovePlayerPlatformCollision = Disable player platform collision
customUI.triggerVolumeEffectEditor.effectType.SpawnItems = Spawn Items
customUI.triggerVolumeEffectEditor.effectType.ConvertBlocksToEntities = Convert blocks to entities
customUI.triggerVolumeEffectEditor.effectType.AttachMovingParticles = Attach moving particles
customUI.triggerVolumeEffectEditor.effectType.AttachMovingParticles.tooltip = Attaches a particle system to existing entities inside the volume. This is not Play VFX: Play VFX creates a world effect that does not follow a platform.

customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetX = Destination X
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetX.tooltip = X destination according to the selected coordinate mode.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetX.placeholder = e.g. 120
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetY = Destination Y
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetY.tooltip = Y destination according to the selected coordinate mode.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetY.placeholder = e.g. 64
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetZ = Destination Z
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetZ.tooltip = Z destination according to the selected coordinate mode.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TargetZ.placeholder = e.g. -30
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.CoordinateMode = Coordinate mode
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.CoordinateMode.tooltip = Absolute uses world coordinates. Relative moves each entity from its current position.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.CoordinateMode.option.ABSOLUTE = Absolute
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.CoordinateMode.option.RELATIVE = Relative
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.Speed = Speed X
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.Speed.tooltip = Movement speed on X in blocks per second. Use 0 to keep X still.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.SpeedY = Speed Y
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.SpeedY.tooltip = Movement speed on Y in blocks per second. Use 0 to keep Y still.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.SpeedZ = Speed Z
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.SpeedZ.tooltip = Movement speed on Z in blocks per second. Use 0 to keep Z still.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.LoopBack = Return to start in a loop
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.LoopBack.tooltip = Enable to travel to the destination and back forever along the same straight line. Disable to move once and stay at the destination.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.DestroyAtDestination = Destroy on arrival
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.DestroyAtDestination.tooltip = Removes the entity when it reaches the destination. If looping is also enabled, the entity is destroyed on its first arrival and does not return.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection = Turn direction
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection.tooltip = Turns relative to the entity's current facing while it moves.
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection.option.NONE = No turn
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection.option.RIGHT = Right
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnDirection.option.LEFT = Left
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnAngle = Turn angle
customUI.triggerVolumeEffectEditor.field.ApplyHorizontalPlatformMotion.TurnAngle.tooltip = Angle between 0 and 180 degrees. The turn finishes on arrival.
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.CollisionConfig = Collision configuration
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.CollisionConfig.tooltip = Use HardCollision so players can stand on the entity and be carried by it. SoftCollision lets players pass through.
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.CollisionConfig.placeholder = HardCollision
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.OnlyFirstMatch = Only first platform
customUI.triggerVolumeEffectEditor.field.ApplyPlayerPlatformCollision.OnlyFirstMatch.tooltip = Enable this when collision should be applied to only one matching prop or NPC marker.
customUI.triggerVolumeEffectEditor.field.RemovePlayerPlatformCollision.OnlyFirstMatch = Only first platform
customUI.triggerVolumeEffectEditor.field.RemovePlayerPlatformCollision.OnlyFirstMatch.tooltip = Enable this when collision should be removed from only one matching prop or NPC marker.

customUI.triggerVolumeEffectEditor.field.SpawnItems.Item = Item
customUI.triggerVolumeEffectEditor.field.SpawnItems.Item.tooltip = Item shown as a persistent prop entity. It cannot be picked up or merged with other items.
customUI.triggerVolumeEffectEditor.field.SpawnItems.X = X coordinate
customUI.triggerVolumeEffectEditor.field.SpawnItems.X.tooltip = World X coordinate or X offset from the Trigger Volume, depending on the selected mode.
customUI.triggerVolumeEffectEditor.field.SpawnItems.X.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.Y = Y coordinate
customUI.triggerVolumeEffectEditor.field.SpawnItems.Y.tooltip = World Y coordinate or Y offset from the Trigger Volume, depending on the selected mode.
customUI.triggerVolumeEffectEditor.field.SpawnItems.Y.placeholder = e.g. 2
customUI.triggerVolumeEffectEditor.field.SpawnItems.Z = Z coordinate
customUI.triggerVolumeEffectEditor.field.SpawnItems.Z.tooltip = World Z coordinate or Z offset from the Trigger Volume, depending on the selected mode.
customUI.triggerVolumeEffectEditor.field.SpawnItems.Z.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.CoordinateMode = Coordinate mode
customUI.triggerVolumeEffectEditor.field.SpawnItems.CoordinateMode.tooltip = Absolute uses world coordinates. Relative adds XYZ to the Trigger Volume origin.
customUI.triggerVolumeEffectEditor.field.SpawnItems.CoordinateMode.option.ABSOLUTE = Absolute
customUI.triggerVolumeEffectEditor.field.SpawnItems.CoordinateMode.option.RELATIVE_TO_VOLUME = Relative to volume
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationX = X rotation
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationX.tooltip = Pitch around the X axis in degrees. Example: 90.
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationX.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationY = Y rotation
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationY.tooltip = Yaw around the Y axis in degrees. Example: 180.
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationY.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationZ = Z rotation
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationZ.tooltip = Roll around the Z axis in degrees. Example: 45.
customUI.triggerVolumeEffectEditor.field.SpawnItems.RotationZ.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.SpawnItems.Scale = Scale
customUI.triggerVolumeEffectEditor.field.SpawnItems.Scale.tooltip = Size multiplier. 1 is the vanilla spawner size, 0.5 is half, and 2 is double.
customUI.triggerVolumeEffectEditor.field.SpawnItems.Scale.placeholder = e.g. 1
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision = Collision type
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision.tooltip = None allows passing through the entity. Hard creates a solid player surface. Soft keeps non-blocking collision interactions.
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision.option.NONE = None
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision.option.HARD = Hard
customUI.triggerVolumeEffectEditor.field.SpawnItems.Collision.option.SOFT = Soft

customUI.triggerVolumeEffectEditor.field.ConvertBlocksToEntities.Item = Item
customUI.triggerVolumeEffectEditor.field.ConvertBlocksToEntities.Item.tooltip = Item used to represent every converted block. Items and blocks are supported. The entity keeps the original block's center position and rotation.
customUI.triggerVolumeEffectEditor.field.ConvertBlocksToEntities.Collision = Player collision
customUI.triggerVolumeEffectEditor.field.ConvertBlocksToEntities.Collision.tooltip = Select how players interact with each created entity. Hard lets players stand on it; soft lets them pass through.
customUI.triggerVolumeEffectEditor.field.ConvertBlocksToEntities.Collision.option.NONE = No collision
customUI.triggerVolumeEffectEditor.field.ConvertBlocksToEntities.Collision.option.HARD = Hard collision
customUI.triggerVolumeEffectEditor.field.ConvertBlocksToEntities.Collision.option.SOFT = Soft collision

customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.ParticleSystem = Particle system
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.ParticleSystem.tooltip = IMPORTANT: this effect does not spawn or move an entity. Place the existing entity inside the Trigger Volume, run this effect before Move Entity, and leave Detach from Entity disabled. Select the particle system emitted from that entity.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetX = X offset
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetX.tooltip = Local X offset from the entity anchor, in blocks. Example: 0.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetX.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetY = Y offset
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetY.tooltip = Local Y offset from the entity anchor, in blocks. Use a negative value to place the emitter below the platform.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetY.placeholder = e.g. -1
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetZ = Z offset
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetZ.tooltip = Local Z offset from the entity anchor, in blocks. Example: 0.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OffsetZ.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationX = X rotation
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationX.tooltip = Particle emitter pitch in degrees relative to the entity. Example: 180 to reverse its vertical direction.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationX.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationY = Y rotation
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationY.tooltip = Particle emitter yaw in degrees relative to the entity. Example: 90.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationY.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationZ = Z rotation
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationZ.tooltip = Particle emitter roll in degrees relative to the entity. Example: 0.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.RotationZ.placeholder = e.g. 0
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.Scale = Scale
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.Scale.tooltip = Particle size multiplier. 1 is normal size, 0.5 is half, and 2 is double.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.Scale.placeholder = e.g. 1
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.TargetNodeName = Model node
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.TargetNodeName.tooltip = Optional bone or node name from the model hierarchy. The emitter follows that animated point, such as a hand or engine nozzle. Leave empty to use the entity root; an unknown node may make the effect appear in the wrong place or not appear.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.TargetNodeName.placeholder = e.g. engine_nozzle
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.DetachEmittedParticles = Detach from entity
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.DetachEmittedParticles.tooltip = Vanilla model-particle behavior. Leave disabled so the particle system follows the moving entity. Enable for a one-shot effect that must stay where it started, such as an explosion or impact while the projectile continues moving.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.ClearOnEntityRemove = Clear when entity is removed
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.ClearOnEntityRemove.tooltip = Clears remaining attached particles when the platform entity is destroyed or removed.
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OnlyFirstMatch = Only closest entity
customUI.triggerVolumeEffectEditor.field.AttachMovingParticles.OnlyFirstMatch.tooltip = Disabled attaches the system to every entity inside the volume. Enabled attaches it only to the entity closest to the volume center. Usually leave disabled and size the volume tightly around the intended platform.
